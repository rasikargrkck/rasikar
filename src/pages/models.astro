---
const pageTitle = 'Three Model Showcase';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Editable three-column model showcase with two images and details per model." />
    <title>{pageTitle}</title>
    <style>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #172033;
        background: #f4f7fb;
        --card: #ffffff;
        --line: #dbe3ef;
        --muted: #6c778b;
        --accent: #315efb;
        --accent-soft: #eef2ff;
        --shadow: 0 18px 50px rgba(25, 40, 72, 0.10);
      }

      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; background: linear-gradient(180deg, #f7f9fc 0%, #eef3fa 100%); }
      button, input, textarea { font: inherit; }

      .shell { width: min(1500px, calc(100% - 32px)); margin: 0 auto; padding: 40px 0 60px; }
      .topbar { display: flex; gap: 20px; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; }
      .title-wrap h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.3rem); letter-spacing: -0.045em; }
      .title-wrap p { margin: 10px 0 0; max-width: 760px; color: var(--muted); line-height: 1.6; }

      .toolbar { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
      .btn { border: 1px solid var(--line); border-radius: 12px; background: white; color: #172033; padding: 11px 14px; cursor: pointer; font-weight: 700; box-shadow: 0 4px 14px rgba(25,40,72,.05); }
      .btn:hover { transform: translateY(-1px); }
      .btn.primary { background: var(--accent); color: white; border-color: var(--accent); }
      .btn.danger { color: #a51d2d; }

      .notice { display: flex; gap: 10px; align-items: center; margin: 0 0 22px; padding: 12px 14px; border: 1px solid #cbd7ff; background: var(--accent-soft); border-radius: 12px; color: #2c4487; font-size: .93rem; }
      .notice strong { white-space: nowrap; }

      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .card { background: var(--card); border: 1px solid rgba(216,225,238,.95); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); }
      .card-head { padding: 20px 20px 12px; border-bottom: 1px solid #edf1f6; }
      .index { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 28px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-weight: 800; font-size: .8rem; letter-spacing: .08em; }
      .model-name { width: 100%; margin: 12px 0 0; border: 0; outline: 0; padding: 0; font-size: 1.45rem; font-weight: 800; color: #172033; background: transparent; }
      .model-name::placeholder { color: #a3acbb; }

      .images { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 16px 16px 6px; }
      .photo-box { aspect-ratio: 4/5; border-radius: 14px; overflow: hidden; background: #edf2f8; border: 1px dashed #c7d0de; position: relative; }
      .photo-box img { width: 100%; height: 100%; object-fit: cover; display: none; }
      .photo-box.has-image img { display: block; }
      .photo-box.has-image .upload-label { opacity: 0; }
      .photo-box:hover .upload-label { opacity: 1; background: rgba(15,23,42,.62); color: white; }
      .upload-label { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 16px; cursor: pointer; color: #6d7889; font-weight: 750; transition: .18s ease; }
      .upload-label small { display: block; margin-top: 5px; font-weight: 500; opacity: .85; }
      .upload-input { display: none; }

      .details { padding: 14px 20px 22px; display: grid; gap: 12px; }
      .field label { display: block; margin-bottom: 6px; color: #596579; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .075em; }
      .field input, .field textarea { width: 100%; border: 1px solid var(--line); background: #fbfcfe; border-radius: 10px; padding: 10px 11px; color: #172033; outline: none; }
      .field input:focus, .field textarea:focus { border-color: #8ca6ff; box-shadow: 0 0 0 3px rgba(49,94,251,.10); background: white; }
      .field textarea { min-height: 112px; resize: vertical; line-height: 1.5; }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

      .saved { position: fixed; right: 20px; bottom: 20px; background: #172033; color: white; padding: 10px 14px; border-radius: 999px; font-weight: 700; font-size: .85rem; opacity: 0; transform: translateY(8px); pointer-events: none; transition: .2s ease; }
      .saved.show { opacity: 1; transform: translateY(0); }

      @media (max-width: 980px) {
        .grid { grid-template-columns: 1fr; }
        .topbar { flex-direction: column; }
        .toolbar { justify-content: flex-start; }
        .card { max-width: 760px; width: 100%; margin: 0 auto; }
      }
      @media (max-width: 560px) {
        .shell { width: min(100% - 20px, 1500px); padding-top: 24px; }
        .images, .two { grid-template-columns: 1fr; }
        .photo-box { aspect-ratio: 16/10; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <div class="topbar">
        <div class="title-wrap">
          <h1>Model Information</h1>
          <p>Add two pictures and the details for each of three models. Your edits are saved automatically in this browser.</p>
        </div>
        <div class="toolbar">
          <button class="btn" id="saveBtn" type="button">Save now</button>
          <button class="btn primary" id="exportBtn" type="button">Export shareable page</button>
          <button class="btn danger" id="clearBtn" type="button">Clear all</button>
        </div>
      </div>

      <div class="notice"><strong>Sharing:</strong><span>Use “Export shareable page” after entering everything. It creates one self-contained HTML file with your text and pictures embedded.</span></div>

      <section class="grid" aria-label="Three model profiles">
        {[1,2,3].map((n) => (
          <article class="card" data-model={n}>
            <div class="card-head">
              <span class="index">MODEL {n}</span>
              <input class="model-name persist" data-key={`m${n}-name`} placeholder={`Model ${n} name`} aria-label={`Model ${n} name`} />
            </div>

            <div class="images">
              {[1,2].map((p) => (
                <div class="photo-box" data-photo-box>
                  <img alt={`Model ${n} photo ${p}`} data-photo-preview data-key={`m${n}-photo${p}`} />
                  <label class="upload-label">
                    <span>Upload photo {p}<small>Click to choose an image</small></span>
                    <input class="upload-input" type="file" accept="image/*" data-photo-input data-key={`m${n}-photo${p}`} />
                  </label>
                </div>
              ))}
            </div>

            <div class="details">
              <div class="two">
                <div class="field"><label>Category / Type</label><input class="persist" data-key={`m${n}-category`} placeholder="e.g. Model type" /></div>
                <div class="field"><label>ID / Reference</label><input class="persist" data-key={`m${n}-id`} placeholder="Optional" /></div>
              </div>
              <div class="field"><label>Key details</label><textarea class="persist" data-key={`m${n}-details`} placeholder="Type the important details here..."></textarea></div>
              <div class="field"><label>Notes</label><textarea class="persist" data-key={`m${n}-notes`} placeholder="Additional notes, links, measurements, or other information..."></textarea></div>
            </div>
          </article>
        ))}
      </section>
    </main>

    <div class="saved" id="savedToast">Saved</div>

    <script is:inline>
      const STORAGE_KEY = 'three-model-showcase-v1';
      const fields = [...document.querySelectorAll('.persist')];
      const photoInputs = [...document.querySelectorAll('[data-photo-input]')];
      const state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      let saveTimer;

      function toast(message = 'Saved') {
        const el = document.getElementById('savedToast');
        el.textContent = message;
        el.classList.add('show');
        clearTimeout(el._timer);
        el._timer = setTimeout(() => el.classList.remove('show'), 1400);
      }

      function save() {
        fields.forEach((field) => { state[field.dataset.key] = field.value; });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        toast();
      }

      function scheduleSave() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(save, 250);
      }

      function setPhoto(key, dataUrl) {
        state[key] = dataUrl;
        const img = document.querySelector(`[data-photo-preview][data-key="${key}"]`);
        if (!img) return;
        img.src = dataUrl;
        img.closest('[data-photo-box]').classList.toggle('has-image', Boolean(dataUrl));
      }

      fields.forEach((field) => {
        if (state[field.dataset.key] != null) field.value = state[field.dataset.key];
        field.addEventListener('input', scheduleSave);
      });

      document.querySelectorAll('[data-photo-preview]').forEach((img) => {
        const saved = state[img.dataset.key];
        if (saved) setPhoto(img.dataset.key, saved);
      });

      photoInputs.forEach((input) => {
        input.addEventListener('change', () => {
          const file = input.files?.[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => {
            const image = new Image();
            image.onload = () => {
              const maxSide = 1600;
              const scale = Math.min(1, maxSide / Math.max(image.width, image.height));
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(image.width * scale);
              canvas.height = Math.round(image.height * scale);
              const ctx = canvas.getContext('2d');
              ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
              const dataUrl = canvas.toDataURL('image/jpeg', 0.84);
              setPhoto(input.dataset.key, dataUrl);
              save();
            };
            image.src = reader.result;
          };
          reader.readAsDataURL(file);
        });
      });

      document.getElementById('saveBtn').addEventListener('click', save);

      document.getElementById('clearBtn').addEventListener('click', () => {
        if (!confirm('Clear all text and photos from this page?')) return;
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
      });

      document.getElementById('exportBtn').addEventListener('click', () => {
        save();
        const s = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        const esc = (value = '') => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const blocks = [1,2,3].map(n => {
          const photo = p => s[`m${n}-photo${p}`] ? `<img src="${s[`m${n}-photo${p}`]}" alt="${esc(s[`m${n}-name`] || `Model ${n}`)} photo ${p}">` : `<div class="blank">No photo</div>`;
          return `<article class="card"><header><span>MODEL ${n}</span><h2>${esc(s[`m${n}-name`] || `Model ${n}`)}</h2></header><div class="photos">${photo(1)}${photo(2)}</div><dl><dt>Category / Type</dt><dd>${esc(s[`m${n}-category`] || '—')}</dd><dt>ID / Reference</dt><dd>${esc(s[`m${n}-id`] || '—')}</dd><dt>Key details</dt><dd class="pre">${esc(s[`m${n}-details`] || '—')}</dd><dt>Notes</dt><dd class="pre">${esc(s[`m${n}-notes`] || '—')}</dd></dl></article>`;
        }).join('');

        const html = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Model Information</title><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:#f4f7fb;color:#172033}.wrap{width:min(1500px,calc(100% - 32px));margin:auto;padding:42px 0 60px}h1{font-size:clamp(2rem,4vw,3.2rem);margin:0 0 24px;letter-spacing:-.04em}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{background:#fff;border:1px solid #dbe3ef;border-radius:20px;overflow:hidden;box-shadow:0 18px 50px rgba(25,40,72,.1)}header{padding:20px;border-bottom:1px solid #edf1f6}header span{color:#315efb;font-size:.75rem;font-weight:800;letter-spacing:.08em}h2{margin:8px 0 0;font-size:1.45rem}.photos{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px 16px 6px}.photos img,.blank{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:14px;background:#edf2f8}.blank{display:grid;place-items:center;color:#8893a4}dl{padding:6px 20px 22px;margin:0}dt{margin-top:14px;color:#596579;font-size:.76rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}dd{margin:5px 0 0;line-height:1.55}.pre{white-space:pre-wrap}@media(max-width:980px){.grid{grid-template-columns:1fr}.card{max-width:760px;margin:auto}}@media(max-width:560px){.photos{grid-template-columns:1fr}}</style></head><body><main class="wrap"><h1>Model Information</h1><section class="grid">${blocks}</section></main></body></html>`;
        const blob = new Blob([html], { type: 'text/html' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'model-information.html';
        a.click();
        URL.revokeObjectURL(url);
        toast('Share page exported');
      });
    </script>
  </body>
</html>
