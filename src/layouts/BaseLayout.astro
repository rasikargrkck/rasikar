---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rasika Rathnayake',
  description = 'Professional website of Rasika Rathnayake, PhD candidate and neuroscience researcher at the University at Buffalo.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const fullTitle = title === 'Rasika Rathnayake'
  ? title
  : `${title} | Rasika Rathnayake`;

const navigation = [
  { name: 'Home', href: base },
  { name: 'About', href: `${base}about/` },
  { name: 'Academic', href: `${base}academic/` },
  { name: 'Research', href: `${base}research/` },
  { name: 'CV', href: `${base}cv/` },
  { name: 'Resources', href: `${base}resources/` },
  { name: 'Contact', href: `${base}contact/` },
];

const isActive = (href: string) => {
  if (href === base) return currentPath === base;
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030a12" />

    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href={base} aria-label="Rasika Rathnayake homepage">
          <span class="brand-name">Rasika Rathnayake</span>
          <span class="brand-role">Neuroscience Researcher</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span></span><span></span><span></span>
          <span class="sr-only">Open navigation</span>
        </button>

        <nav id="primary-navigation" class="nav-links" aria-label="Main navigation">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <p>
          <strong>Rasika Rathnayake</strong>
          <span aria-hidden="true">•</span>
          University at Buffalo
        </p>

        <p>© {new Date().getFullYear()} Rasika Rathnayake</p>

        <div class="footer-social" aria-label="Professional profiles">
          <a href="https://www.linkedin.com/in/rasikarr/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
          <a href="https://scholar.google.com/citations?user=hDazJfwAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar">GS</a>
          <a href="https://orcid.org/0000-0001-9667-8761" target="_blank" rel="noopener noreferrer" aria-label="ORCID">iD</a>
          <a href="https://www.researchgate.net/profile/Rasika_Rathnayake2" target="_blank" rel="noopener noreferrer" aria-label="ResearchGate">RG</a>
          <a href="mailto:rasikara@buffalo.edu" aria-label="Email">@</a>
        </div>
      </div>
    </footer>

    <script>
      const button = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('.nav-links');

      button?.addEventListener('click', () => {
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isOpen));
        navigation?.classList.toggle('open', !isOpen);
      });
    </script>
  </body>
</html>
